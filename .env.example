# ---------------------------------------------------------------------------
# Upstash Redis (server-side capture buffer)
#
# Vercel:  Storage tab -> Marketplace -> Upstash -> Redis.  Vercel injects these
#          two variables automatically; you do not need to paste anything.
# Local:   create a free database at https://console.upstash.com and copy the
#          "REST API" credentials below.
#
# If BOTH are missing the app silently falls back to an in-memory store so that
# `npm run dev` works with zero configuration. That store is wiped on restart
# and is NOT usable on serverless — always set these in production.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel's Upstash marketplace integration does not use the names above: it
# prefixes what it injects with the store's name, e.g. a store called
# "webhook-inbox" yields WEBHOOK_INBOX_KV_REST_API_URL and
# WEBHOOK_INBOX_KV_REST_API_TOKEN. Those are picked up automatically — you do
# not need to rename or re-add anything. The *_READ_ONLY_TOKEN variant is
# ignored; capture needs write access.

# Server-side retention for captured requests, in seconds. Default 30 days.
# Your browser copy is permanent regardless of this value.
# Leaving this blank (or omitting it) uses the default — it does not mean zero.
WEBHOOK_RETENTION_SECONDS=2592000

# Max requests kept server-side per endpoint (ring buffer). Default 200.
# Blank or omitted uses the default. Values must be positive integers; anything
# else is ignored with a warning in the server logs.
WEBHOOK_MAX_REQUESTS=200

# Optional. Public origin used when rendering endpoint URLs. Leave blank to
# derive it from the incoming request (correct in virtually all deployments).
NEXT_PUBLIC_BASE_URL=
